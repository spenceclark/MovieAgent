{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Extensions.Hosting.Internal.Host": "Critical",
      "Microsoft.Extensions.AI": "Warning",
      "Npgsql": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "Database": {
    "ConnectionString": "Host=localhost;Port=5434;Database=pagila;Username=postgres;Password=123456",
    "CommandTimeoutSeconds": 30
  },
  "Llm": {
    "Provider": "Ollama",
    "OpenAI": {
      "ApiKey": "",
      "Model": "gpt-5.5",
      "Endpoint": null,
      "RetryMaxAttempts": 5
    },
    "Ollama": {
      "Endpoint": "http://localhost:11434",
      "Model": "andrewmccall/gemma3-tools",
      "TimeoutSeconds": 300
    }
  },
  "Agent": {
    "MaxIterations": 10,
    "ToolSurface": "standard+desc",
    "Seed": 42,
    "Temperature": 0.0,
    "Repeats": 1,
    "Thinking": false,
    "MaxOutputTokens": 6000
  },
  "EvalSet": {
    "Files": "pagila-v1.json,pagila-v2.json"
  },
  "Recorder": {
    "FilePath": ""
  }
}
